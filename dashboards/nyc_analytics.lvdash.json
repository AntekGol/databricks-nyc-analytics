{
  "datasets": [
    {
      "name": "ds_daily",
      "displayName": "Daily Mobility and Air Quality",
      "queryLines": [
        "SELECT trip_date, year, total_trips, total_revenue_usd, total_revenue_eur,\n",
        "       avg_revenue_per_trip_usd, avg_revenue_per_trip_eur, usd_per_eur,\n",
        "       pm25_avg, no2_avg, o3_avg\n",
        "FROM workspace.gold.vw_mobility_air_quality_daily\n",
        "ORDER BY trip_date"
      ]
    },
    {
      "name": "ds_borough_trips",
      "displayName": "Taxi Trips by Borough",
      "queryLines": [
        "SELECT borough, SUM(trip_count) AS total_trips,\n",
        "       ROUND(AVG(avg_fare_usd), 2) AS avg_fare_usd,\n",
        "       ROUND(SUM(total_revenue_usd), 2) AS total_revenue_usd\n",
        "FROM workspace.gold.fact_taxi_daily\n",
        "WHERE borough IS NOT NULL\n",
        "GROUP BY borough\n",
        "ORDER BY total_trips DESC"
      ]
    },
    {
      "name": "ds_top_zones",
      "displayName": "Top 15 Pickup Zones",
      "queryLines": [
        "SELECT z.borough, z.zone_name, SUM(f.trip_count) AS total_trips,\n",
        "       ROUND(AVG(f.avg_fare_usd), 2) AS avg_fare_usd,\n",
        "       ROUND(AVG(f.avg_trip_duration_min), 1) AS avg_duration_min,\n",
        "       ROUND(SUM(f.total_revenue_usd), 2) AS total_revenue_usd\n",
        "FROM workspace.gold.fact_taxi_daily f\n",
        "JOIN workspace.gold.dim_zone z ON f.zone_key = z.zone_key\n",
        "GROUP BY z.borough, z.zone_name\n",
        "ORDER BY total_trips DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "ds_aq_pm25_borough",
      "displayName": "Daily PM2.5 by Borough",
      "queryLines": [
        "SELECT measurement_date, borough, avg_value AS pm25_avg\n",
        "FROM workspace.gold.fact_air_quality_daily\n",
        "WHERE parameter = 'pm25'\n",
        "ORDER BY measurement_date"
      ]
    },
    {
      "name": "ds_aq_summary",
      "displayName": "Pollutant Summary by Borough",
      "queryLines": [
        "SELECT borough, parameter, units,\n",
        "       ROUND(AVG(avg_value), 3) AS mean_value,\n",
        "       ROUND(MIN(min_value), 3) AS min_value,\n",
        "       ROUND(MAX(max_value), 3) AS max_value,\n",
        "       SUM(measurement_count) AS total_readings\n",
        "FROM workspace.gold.fact_air_quality_daily\n",
        "GROUP BY borough, parameter, units\n",
        "ORDER BY parameter, mean_value DESC"
      ]
    },
    {
      "name": "ds_hourly",
      "displayName": "Hourly Mobility vs Air Quality",
      "queryLines": [
        "SELECT hour_of_day, total_trips, avg_revenue_usd, pm25_avg, no2_avg\n",
        "FROM workspace.gold.vw_hourly_mobility_air_quality\n",
        "ORDER BY hour_of_day"
      ]
    },
    {
      "name": "ds_economy",
      "displayName": "Economic Impact and FX",
      "queryLines": [
        "SELECT year, year_month, total_trips, total_revenue_usd, total_revenue_eur,\n",
        "       avg_revenue_per_trip_usd, avg_revenue_per_trip_eur, avg_usd_per_eur,\n",
        "       ROUND(gdp_usd / 1e12, 2) AS gdp_trillion_usd, yoy_growth_pct\n",
        "FROM workspace.gold.vw_economic_impact\n",
        "ORDER BY year_month"
      ]
    }
  ],
