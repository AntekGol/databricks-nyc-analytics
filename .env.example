# databricks sql warehouse connection (for external sync and dq bot)
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapi_your_token_here
DATABRICKS_CATALOG=workspace

# openaq v3 api key (free account at explore.openaq.org)
OPENAQ_API_KEY=your_openaq_api_key

# local timescaledb (docker compose)
TSDB_HOST=localhost
TSDB_PORT=5433
TSDB_DB=weather_tsdb
TSDB_USER=postgres
TSDB_PASSWORD=postgres
WEATHER_SYNC_INTERVAL_MINUTES=60

# discord bot for data quality reports
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=123456789012345678
